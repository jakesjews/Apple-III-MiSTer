`verilator_config

// MiSTer module/file naming, explicitly unused outputs, FPGA power-up values,
// and local names do not need style diagnostics. Keep functional checks enabled.
lint_off -rule DECLFILENAME
lint_off -rule PINCONNECTEMPTY
lint_off -rule PROCASSINIT
lint_off -rule SIMILARNAME
lint_off -rule VARHIDDEN

// Only waive known unused HPS ports in emu. Name each port so accidentally
// dropping a required connection still produces PINMISSING.
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_2'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_3'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_4'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_5'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_l_analog_2'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_l_analog_3'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_l_analog_4'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_l_analog_5'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_r_analog_0'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_r_analog_1'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_r_analog_2'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_r_analog_3'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_r_analog_4'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'joystick_r_analog_5'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'paddle_0'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'paddle_1'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'paddle_2'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'paddle_3'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'paddle_4'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'paddle_5'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'spinner_0'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'spinner_1'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'spinner_2'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'spinner_3'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'spinner_4'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'spinner_5'"
// Physical PS/2 pins are inactive with the default hps_io PS2DIV=0.
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ps2_kbd_clk_out'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ps2_kbd_data_out'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ps2_kbd_clk_in'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ps2_kbd_data_in'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ps2_mouse_clk_out'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ps2_mouse_data_out'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ps2_mouse_clk_in'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ps2_mouse_data_in'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ps2_mouse'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ps2_mouse_ext'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'direct_video'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ioctl_upload'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ioctl_rd'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'ioctl_file_ext'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'sdram_sz'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'TIMESTAMP'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'uart_mode'"
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'uart_speed'"

// Project debug outputs are consumed by testbenches, not the MiSTer wrapper.
lint_off -rule PINMISSING -file "Apple-III.sv" -match "*Instance has missing pin: 'debug_*'"

// FPGA configuration starts the free-running video chain and battery-backed
// RTC once. These initial writes are not competing clocked drivers. Match the
// reported initialization, not every MULTIDRIVEN diagnostic in these modules.
lint_off -rule MULTIDRIVEN -file "rtl/apple3_timing.sv" -match "*'q_divider'*Location of other write*q_divider*= 3'd0;*"
lint_off -rule MULTIDRIVEN -file "rtl/apple3_timing.sv" -match "*'state_dot'*Location of other write*state_dot*= 4'd0;*"
lint_off -rule MULTIDRIVEN -file "rtl/apple3_timing.sv" -match "*'h_state'*Location of other write*h_state*= 7'd0;*"
lint_off -rule MULTIDRIVEN -file "rtl/apple3_timing.sv" -match "*'h_count'*Location of other write*h_count*= 10'd0;*"
lint_off -rule MULTIDRIVEN -file "rtl/apple3_timing.sv" -match "*'v_count'*Location of other write*v_count*= 9'd0;*"
lint_off -rule MULTIDRIVEN -file "rtl/apple3_rtc.sv" -match "*'compare_match_d'*Location of other write*compare_match_d*= 1'b0;*"
lint_off -rule MULTIDRIVEN -file "rtl/apple3_rtc.sv" -match "*'millisecond_divider'*Location of other write*millisecond_divider*= 14'd0;*"
lint_off -rule MULTIDRIVEN -file "rtl/apple3_rtc.sv" -match "*'rollover_status'*Location of other write*rollover_status*= 1'b0;*"
lint_off -rule MULTIDRIVEN -file "rtl/apple3_rtc.sv" -match "*'counter_read_pending'*Location of other write*counter_read_pending*= 1'b0;*"
lint_off -rule MULTIDRIVEN -file "rtl/apple3_rtc.sv" -match "*'host_toggle'*Location of other write*host_toggle*= 1'b0;*"
lint_off -rule MULTIDRIVEN -file "rtl/apple3_rtc.sv" -match "*'irq_control'*Location of other write*irq_control*= 8'h00;*"
// The year diagnostic reports advance_minute's write instead of its initial
// value; both task call sites and host seeding belong to the same always_ff.
lint_off -rule MULTIDRIVEN -file "rtl/apple3_rtc.sv" -match "*'year_bcd'*year_bcd*<= host_rtc[47:40];*Location of other write*year_bcd*<= bcd_increment(year_bcd);*"

// Video requests span 0..79 and split into two 0..39 buffers. Visible text
// reads have h_state < 40. Preserve diagnostics for other widths/expressions.
lint_off -rule WIDTHTRUNC -file "rtl/apple3_video.sv" -match "*Bit extraction of array[39:0] requires 6 bit index, not 7 bits.*line_buffer_low[request_index_d]*"
lint_off -rule WIDTHTRUNC -file "rtl/apple3_video.sv" -match "*Bit extraction of array[39:0] requires 6 bit index, not 7 bits.*line_buffer_high[request_index_d-7'd40]*"
lint_off -rule WIDTHTRUNC -file "rtl/apple3_video.sv" -match "*Bit extraction of array[39:0] requires 6 bit index, not 7 bits.*line_buffer_*[h_state]*"
// Comparing an unsigned divider with an integer constant safely extends it.
lint_off -rule WIDTHEXPAND -file "rtl/apple3_rtc.sv" -match "*Operator LT expects 32 bits on the LHS, but LHS's VARREF 'millisecond_divider' generates 14 bits.*"
// A multi-bit conditional deliberately tests whether any video effect is on.
lint_off -rule WIDTHTRUNC -file "Apple-III.sv" -match "*Logical operator COND expects 1 bit on the Conditional Test, but Conditional Test's VARREF 'video_effect' generates 3 bits.*"

// MiSTer provides wider controls than this core consumes. OSD video effects
// only select scanline levels 0..3, so the third result bit is unused.
lint_off -rule UNUSEDSIGNAL -file "Apple-III.sv" -match "*Bits of signal are not used: 'hps_buttons'[0]*"
lint_off -rule UNUSEDSIGNAL -file "Apple-III.sv" -match "*Bits of signal are not used: 'joystick_0'[31:6]*"
lint_off -rule UNUSEDSIGNAL -file "Apple-III.sv" -match "*Bits of signal are not used: 'joystick_1'[31:6]*"
lint_off -rule UNUSEDSIGNAL -file "Apple-III.sv" -match "*Bits of signal are not used: 'scanline_level'[2]*"

// Unused CPU debug/VIA bits and observation outputs. The I/O soft switches
// remain modeled; expansion routing and double-sided media are not implemented.
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Bits of signal are not used: 'cpu_regs'[47:40]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Bits of signal are not used: 'e_pb_o'[7:6]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Bits of signal are not used: 'e_pb_ddr'[7:6]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Signal is not used: 'display_slot'*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Signal is not used: 'refresh_slot'*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Signal is not used: 'pixel_enable'*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Signal is not used: 'external_select'*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Signal is not used: 'serial_enable'*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Signal is not used: 'analog_select'*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Signal is not used: 'side_two'*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Signal is not used: 'd1_io_active'*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_core.sv" -match "*Signal is not used: 'd2_io_active'*"

// The default 256 KiB RAM uses 17 word-address bits; the shared interface also
// supports the optional 512 KiB configuration, which consumes the extra bit.
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_ram.sv" -match "*Bits of signal are not used: 'cpu_addr'[17]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_ram.sv" -match "*Bits of signal are not used: 'video_addr'[17]*"
// A repeat is already qualified by held_key_valid; only its character is used.
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_keyboard.sv" -match "*Bits of signal are not used: 'repeat_translation'[8]*"
// Host RTC padding and reserved BCD bits are intentionally discarded.
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_rtc.sv" -match "*Bits of signal are not used: 'host_rtc'[63:51,39:37,31:30,23:22,15,7]*"
// The P6 sequencer derives its phase from clk_2m (Q3), not this legacy input.
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_disk.sv" -match "*Signal is not used: 'phase_zero'*"

// Visible buffer positions use six bits; 140-pixel grouping discards the two
// subpixel bits. Packed graphics use seven data bits from each fetched byte.
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_video.sv" -match "*Bits of signal are not used: 'h_state'[6]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_video.sv" -match "*Bits of signal are not used: 'within_28'[1:0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_video.sv" -match "*Bits of signal are not used: 'p1'[7]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_video.sv" -match "*Bits of signal are not used: 'p2'[7]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_video.sv" -match "*Bits of signal are not used: 'p3'[7]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_video.sv" -match "*Bits of signal are not used: 'p4'[7]*"
// Character reload visits exactly 64 screen-hole pairs.
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_video.sv" -match "*Bits of signal are not used: 'char_slot'[6]*"
// Non-MMU environment bits are consumed elsewhere. Bank addressing only uses
// the low nibble, plus the extended-bank high bit for the system-map override.
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_mmu.sv" -match "*Bits of signal are not used: 'environment'[7,5:4]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_mmu.sv" -match "*Bits of signal are not used: 'bank_register'[7:4]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/apple3_mmu.sv" -match "*Bits of signal are not used: 'extended_bank'[6:4]*"

// Keep the MiSTer framework out of lint diagnostics while using its real
// module interfaces for elaboration. Generic lint_off covers lint/style
// warnings; the named diagnostics below need explicit exclusions.
lint_off -file "sys/*"
lint_off -rule TIMESCALEMOD -file "sys/*"
lint_off -rule SIMILARNAME -file "sys/*"
lint_off -rule PROCASSWIRE -file "sys/*"
lint_off -rule UNOPTFLAT -file "sys/*"

// Focus lint on project RTL. Keep vendored modules loaded for connection
// checks, but suppress their lint warnings, including in locally modified code.
lint_off -file "rtl/acia/*"
lint_off -file "rtl/disk/woz/*"

// GHDL output is generated from the vendored VHDL and our T65 wrapper.
lint_off -file "sim/gen/*"
lint_off -rule TIMESCALEMOD -file "sim/gen/*"
lint_off -rule SIMILARNAME -file "sim/gen/*"

// The PLL is a port-only boundary, not a behavioral model.
lint_off -file "lint/pll.sv"
lint_off -rule TIMESCALEMOD -file "lint/pll.sv"
