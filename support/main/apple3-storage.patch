+int a2_woz_validate(const uint8_t *buf, size_t size, A2WozInfo *info)
+{
+	int type = woz_disk_type(buf, size);
+	if ((type != 1 && type != 2) || memcmp(buf + 4, "\xff\x0a\x0d\x0a", 4)) return 0;
+	uint32_t crc = rd_le32(buf + 8);
+	if (crc && crc != woz_crc32(buf + 12, size - 12)) return 0;
+	const uint8_t *inf = NULL, *map = NULL, *tracks = NULL;
+	size_t track_size = 0;
+	int flux = 0;
+	for (size_t pos = 12; pos < size;) {
+		if (size - pos < 8) return 0;
+		uint32_t n = rd_le32(buf + pos + 4);
+		if (n > size - pos - 8) return 0;
+		const uint8_t *data = buf + pos + 8;
+		if (!memcmp(buf + pos, "INFO", 4)) { if (inf || n != 60) return 0; inf = data; }
+		if (!memcmp(buf + pos, "TMAP", 4)) { if (map || n != 160) return 0; map = data; }
+		if (!memcmp(buf + pos, "TRKS", 4)) { if (tracks) return 0; tracks = data; track_size = n; }
+		if (!memcmp(buf + pos, "FLUX", 4)) flux = 1;
+		pos += 8 + n;
+	}
+	if (!inf || !map || !tracks) return 0;
+	const int v1 = buf[3] == '1';
+	if ((!v1 && track_size < 1280) || (v1 && track_size % 6656)) return 0;
+	for (int i = 0; i < 160; ++i) {
+		if (map[i] != 255 && (map[i] >= 160 || (v1 && (size_t)map[i] >= track_size / 6656))) return 0;
+		if (v1) continue;
+		const uint8_t *e = tracks + i * 8;
+		uint32_t block = rd_le16(e), count = rd_le16(e + 2), bits = rd_le32(e + 4);
+		if (!count) { if (bits || block) return 0; continue; }
+		uint64_t begin = (uint64_t)block * 512, end = begin + (uint64_t)count * 512;
+		if (begin < (size_t)(tracks - buf) + 1280 || end > size ||
+		    end > (size_t)(tracks - buf) + track_size || !bits || (!flux && bits > count * 4096)) return 0;
+	}
+	if (v1) for (size_t pos = 0; pos < track_size; pos += 6656) {
+		uint32_t bytes = rd_le16(tracks + pos + 6646), bits = rd_le16(tracks + pos + 6648);
+		if (bytes > 6646 || bits > bytes * 8 || !bits) return 0;
+	}
+	if (info) {
+		info->disk_type = type;
+		info->version = v1 ? 1 : 2;
