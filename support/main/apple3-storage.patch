@@ -0,0 +1,141 @@
+#include "../../file_io.h"
+#include "../../user_io.h"
+#include "../../support/a2/iigs_fmt.h"
+#include "../../support/a2/iigs_disk.h"
+#include <cassert>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <fstream>
+#include <algorithm>
+
+static std::string core = "Apple-III";
+static bool can_write = true, modern = true;
+static std::vector<uint8_t> to_fpga, from_fpga;
+static unsigned command;
+static std::string message;
+fileTYPE::fileTYPE() : filp(nullptr), mode(0), type(1), zip(nullptr), size(0), offset(0) {}
+fileTYPE::~fileTYPE() { if (filp) fclose(filp); }
+char *user_io_get_core_name(int) { return &core[0]; }
+char user_io_a2_woz_enabled() { return modern; }
+char user_io_a3_woz_enabled() { return modern && core=="Apple-III"; }
+char *user_io_get_confstr(int i) { static char v[] = "S0,WOZDSKDO PO NIB2MG,Drive 1"; return modern && i == 1 ? v : nullptr; }
+int user_io_get_width() { return 0; }
+int FileCanWrite(const char *) { return can_write; }
+int FileSeek(fileTYPE *f, __off64_t off, int whence) { if (fseeko(f->filp, off, whence)) return 0; f->offset = ftello(f->filp); return 1; }
+int FileReadAdv(fileTYPE *f, void *buf, int len, int) { return fread(buf, 1, len, f->filp); }
+int FileWriteAdv(fileTYPE *f, void *buf, int len, int) { int n = fwrite(buf, 1, len, f->filp); fflush(f->filp); return n; }
+void InfoMessage(const char *msg, int, const char *) { message = msg; }
+void EnableIO() {}
+void DisableIO() {}
+uint16_t fpga_spi(uint16_t v) { command = v; return 0; }
+void spi_block_write(const uint8_t *p, int, int n) { to_fpga.assign(p, p+n); }
+void spi_block_read(uint8_t *p, int, int n) { assert(from_fpga.size() == unsigned(n)); memcpy(p, from_fpga.data(), n); }
+static void put32(uint8_t *p, uint32_t v) { for(int i=0;i<4;i++) p[i]=v>>(i*8); }
+static uint32_t get32(const uint8_t *p) { return p[0] | p[1]<<8 | p[2]<<16 | uint32_t(p[3])<<24; }
+static std::vector<uint8_t> bytes(fileTYPE &f) {
+  fseeko(f.filp,0,SEEK_END); size_t n=ftello(f.filp); rewind(f.filp);
+  std::vector<uint8_t> b(n); assert(fread(b.data(),1,n,f.filp)==n); return b;
+}
+static void source(fileTYPE &f, const std::vector<uint8_t> &b) {
+  if(f.filp) fclose(f.filp); f.filp=tmpfile(); assert(f.filp);
+  assert(fwrite(b.data(),1,b.size(),f.filp)==b.size()); fflush(f.filp);
+  f.size=b.size(); f.zip=nullptr; rewind(f.filp);
+}
+static std::vector<uint8_t> serve(int slot, fileTYPE &f) {
+  std::vector<uint8_t> result;
+  for(uint64_t lba=0;lba*512<uint64_t(f.size);lba+=32) {
+    iigs_read(slot,&f,lba,0x100*(slot+1),16384);
+    assert(to_fpga.size()==16384); assert(command==unsigned(UIO_SECTOR_RD|0x100*(slot+1)));
+    result.insert(result.end(),to_fpga.begin(),to_fpga.end());
+  }
+  result.resize(f.size); return result;
+}
+static std::vector<uint8_t> mount_serve(fileTYPE &f, const std::vector<uint8_t> &b, const char *name, int slot=0) {
+  source(f,b); int writable=1; assert(iigs_mount(slot,name,&f,&writable)==IIGS_HANDLED);
+  assert(!writable); return serve(slot,f);
+}
+int main(int argc,char **argv) {
+  fileTYPE f;
+  if(argc==4 && !strcmp(argv[1],"--convert")) {
+    std::ifstream input(argv[2],std::ios::binary);
+    std::vector<uint8_t> b((std::istreambuf_iterator<char>(input)),{});
+    source(f,b); int writable; assert(iigs_mount(0,argv[2],&f,&writable)==IIGS_HANDLED);
+    auto w=serve(0,f); std::ofstream out(argv[3],std::ios::binary); out.write((char*)w.data(),w.size());
+    iigs_unmount(0); return !out;
+  }
+  std::vector<uint8_t> dsk(A2_525_IMAGE_SIZE), po(dsk.size()), back(dsk.size());
+  uint32_t rng=1; for(auto &b:dsk) { rng=rng*1664525+1013904223; b=rng>>24; }
+  auto w=mount_serve(f,dsk,"disk.DSK");
+  A2WozInfo info; assert(a2_woz_validate(w.data(),w.size(),&info)); assert(w[23]==1);
+  assert(a2_woz525_to_dsk(back.data(),w.data(),w.size())); assert(back==dsk);
+  assert(get32(w.data()+260)==50304);
+  from_fpga.assign(1024,0x31); auto original=bytes(f); iigs_write(0,&f,3,0x100,1024);
+  assert(bytes(f)==original); assert(serve(0,f)==w);
+  a2_dos_to_prodos(po.data(),dsk.data()); assert(mount_serve(f,po,"disk.PO")==w);
+  auto do_w=mount_serve(f,dsk,"disk.do",1); assert(do_w==w);
+  std::vector<uint8_t> mg(128+dsk.size()+73); twomg_build(mg.data(),mg.size(),po.data(),po.size(),1);
+  memmove(mg.data()+128,mg.data()+64,po.size()); put32(mg.data()+24,128); put32(mg.data()+16,0);
+  assert(mount_serve(f,mg,"disk.2mg")==w);
+  std::vector<uint8_t> nib(A2_NIB_IMAGE_SIZE); a2_dsk_to_nib(nib.data(),dsk.data());
+  auto nw=mount_serve(f,nib,"disk.nib"); assert(a2_woz525_to_dsk(back.data(),nw.data(),nw.size())); assert(back==dsk);
+  // NIB address volume bytes survive direct packing (never sector decode/rebuild).
+  nib[51]=0xaau; nib[52]=0xab; auto modified=mount_serve(f,nib,"disk.nib"); assert(modified!=nw);
+  puts("PASS shared 5.25 codec: DOS/PO/2MG equivalence, sync bits, round-trip and NIB preservation");
+  // Native WOZ: unknown chunks, raw bits and all metadata remain byte-for-byte.
+  w.insert(w.end(),{'M','E','T','A',3,0,0,0,'x','y','z'}); put32(w.data()+8,woz_crc32(w.data()+12,w.size()-12));
+  source(f,w); int writable=0; assert(iigs_mount(1,"native.woz",&f,&writable)==IIGS_HANDLED && writable);
+  assert(serve(1,f)==w); from_fpga.assign(w.begin()+1536,w.begin()+2560); from_fpga[345]^=0x20;
+  iigs_write(1,&f,3,0x200,1024); auto expected=w; expected[1536+345]^=0x20; memset(expected.data()+8,0,4);
+  assert(bytes(f)==expected); assert(serve(1,f)==expected); assert(a2_woz_validate(expected.data(),expected.size(),&info));
+  from_fpga.assign(512,0); iigs_write(1,&f,0,0x200); assert(bytes(f)==expected);
+  from_fpga.assign(1024,0); iigs_write(1,&f,(f.size/512),0x200,1024); assert(bytes(f)==expected);
+  source(f,expected); assert(iigs_mount(1,"native.woz",&f,&writable)==IIGS_HANDLED && writable); assert(serve(1,f)==expected);
+  expected[22]=1; source(f,expected); assert(iigs_mount(1,"native.woz",&f,&writable)==IIGS_HANDLED && !writable);
+  from_fpga.assign(512,0x55); iigs_write(1,&f,3,0x200); assert(bytes(f)==expected); assert(serve(1,f)==expected);
+  auto bad=w; bad.back()^=1; source(f,bad); assert(iigs_mount(0,"broken.woz",&f,&writable)==IIGS_REJECT);
+  bad=w; put32(bad.data()+8,0); put32(bad.data()+16,0x7fffffff); source(f,bad); assert(iigs_mount(0,"broken.woz",&f,&writable)==IIGS_REJECT);
+  puts("PASS native WOZ: full bursts, CRC, partial EOF, metadata guards, persistence and write protection");
+  // Block slots use the header's payload length, not trailing comments/tags.
+  std::vector<uint8_t> block(2048); for(unsigned i=0;i<block.size();i++) block[i]=i;
+  std::vector<uint8_t> bm(128+block.size()+99); twomg_build(bm.data(),bm.size(),block.data(),block.size(),1);
+  memmove(bm.data()+128,bm.data()+64,block.size()); put32(bm.data()+24,128);
+  assert(mount_serve(f,bm,"block.2mg",2)==block); assert(f.size==2048);
+  from_fpga.assign(512,0xa5); auto before=bytes(f); iigs_write(2,&f,0,0x300); assert(bytes(f)==before);
+  assert(mount_serve(f,block,"block.hdv",3)==block);
+  source(f,w); assert(iigs_mount(2,"floppy.woz",&f,&writable)==IIGS_REJECT);
+  source(f,block); assert(iigs_mount(0,"hard.hdv",&f,&writable)==IIGS_REJECT);
+  source(f,bm); bm[12]=3; source(f,bm); assert(iigs_mount(2,"bad.2mg",&f,&writable)==IIGS_REJECT);
+  core="Apple-II"; source(f,dsk); assert(iigs_mount(2,"disk.dsk",&f,&writable)==IIGS_HANDLED && writable);
+  auto a2w=serve(2,f); assert(a2_woz525_to_dsk(back.data(),a2w.data(),a2w.size()) && back==dsk);
+  source(f,block); assert(iigs_mount(1,"disk.po",&f,&writable)==IIGS_PASSTHRU);
+  // Preserve the other Apple cores' converted-image write-back policy.
+  auto changed_dsk=dsk; changed_dsk[512]^=0x73;
+  std::vector<uint8_t> changed_woz(512*1024);
+  changed_woz.resize(a2_dsk_to_woz525(changed_woz.data(),changed_woz.size(),changed_dsk.data()));
+  source(f,dsk); assert(iigs_mount(0,"disk.dsk",&f,&writable)==IIGS_HANDLED && writable);
+  from_fpga.assign(changed_woz.begin()+1536,changed_woz.begin()+1536+6656);
+  iigs_write(0,&f,3,0,6656); assert(bytes(f)==changed_dsk);
+  // 800K IIgs encoding/decoding also remains on the same backend.
+  core="Apple-IIgs"; std::vector<uint8_t> po35(A2_35_IMAGE_SIZE), back35(po35.size());
+  for(auto &b:po35) { rng=rng*1664525+1013904223; b=rng>>24; }
+  source(f,po35); assert(iigs_mount(2,"disk.po",&f,&writable)==IIGS_HANDLED && writable);
+  auto gs=serve(2,f); assert(a2_woz35_to_po(back35.data(),gs.data(),gs.size()) && back35==po35);
+  // Archives and host permissions force native WOZ read-only without changing it.
+  core="Apple-III"; can_write=false; source(f,w);
+  assert(iigs_mount(0,"native.woz",&f,&writable)==IIGS_HANDLED && !writable);
+  assert(serve(0,f)==w); can_write=true; source(f,w); f.zip=reinterpret_cast<fileZipArchive*>(1);
+  assert(iigs_mount(0,"native.woz",&f,&writable)==IIGS_HANDLED && !writable);
+  assert(serve(0,f)==w); f.zip=nullptr;
+  // A supported FLUX container is read-only and is never converted.
+  auto flux=w; flux.insert(flux.end(),{'F','L','U','X',160,0,0,0}); flux.resize(flux.size()+160,255);
+  flux[20]=3; put32(flux.data()+8,woz_crc32(flux.data()+12,flux.size()-12));
+  source(f,flux); assert(iigs_mount(0,"flux.woz",&f,&writable)==IIGS_HANDLED && !writable); assert(serve(0,f)==flux);
+  // A recognizable malformed container must not fall back to a raw block image.
+  auto overflow=bm; put32(overflow.data()+12,1); put32(overflow.data()+20,0xffffffff); put32(overflow.data()+28,0);
+  source(f,overflow); assert(iigs_mount(2,"bad.2mg",&f,&writable)==IIGS_REJECT);
+  puts("PASS II/IIgs write-back and codec compatibility, native archive/permission/FLUX protection");
+  core="Apple-III"; modern=false; assert(!iigs_is_core()); modern=true; assert(iigs_is_core());
+  for(int i=0;i<16;i++) iigs_unmount(i);
+  puts("PASS Apple-family slot assignments, read-only block payloads, invalid containers and legacy compatibility");
+}
