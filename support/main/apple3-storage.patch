+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+out=${APPLE3_TEST_OUT:-/tmp/mister-apple3-tests}
+mkdir -p "$out"
+${CXX:-c++} -std=c++14 -O1 -g -Wall -Wextra -fsanitize=address,undefined \
+  -include tests/apple3/compat.h tests/apple3/storage_test.cpp \
+  support/a2/iigs_disk.cpp support/a2/iigs_fmt.cpp -o "$out/storage_test"
+"$out/storage_test" "$@"
